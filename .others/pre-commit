#!/bin/bash
# Pre-commit hook for ComfyUI-UsageMonitor.
# Install it with:
#   cp .others/pre-commit .git/hooks/pre-commit
# This hook:
#   1. (optional) validates the web build when web/package.json exists
#   2. syncs the version from the `version` file (via .others/version.py)
#   3. regenerates the multi-language READMEs (via .others/render_i18n.py --once)
#   4. stages all files that may have been touched

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || { echo "Failed to cd to repo root"; exit 1; }

# Resolve a Python interpreter (the scripts only use the standard library).
# GitHub Desktop runs hooks in a clean environment (no user PATH), so we also
# probe well-known install locations. Prefer an optional per-user override
# stored in git config (never committed to the repo):
#   git config --global hooks.python "C:/Python312/python.exe"
PYTHON=""
CONFIG_PY="$(git config --get hooks.python 2>/dev/null)"
if [ -n "$CONFIG_PY" ] && [ -f "$CONFIG_PY" ]; then
    PYTHON="$CONFIG_PY"
elif command -v python >/dev/null 2>&1; then
    PYTHON="python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
elif command -v py >/dev/null 2>&1; then
    PYTHON="py"
else
    # Fall back to common Windows install locations derived from environment
    # variables only (no hard-coded user name). HOME/USERPROFILE may be unset
    # in some Git GUIs, so also probe /c/Users/$USERNAME.
    for base in "$LOCALAPPDATA/Programs/Python" \
                "$HOME" \
                "$USERPROFILE" \
                "$USERPROFILE/AppData/Local/Programs/Python" \
                "/c/Users/$USERNAME"; do
        [ -n "$base" ] || continue
        for p in "$base"/Python*/python.exe \
                 "$base"/miniconda3/python.exe \
                 "$base"/Anaconda3/python.exe \
                 "$base"/python.exe; do
            if [ -f "$p" ]; then
                PYTHON="$(cygpath -m "$p" 2>/dev/null || echo "$p")"
                break 2
            fi
        done
    done
fi

if [ -z "$PYTHON" ]; then
    echo "Python not found. Install Python or add it to PATH." >&2
    exit 1
fi

# 1) (Optional) Validate the web build.
if [ -f web/package.json ]; then
    LOCAL_COMMAND="npm run validate"
    OUTPUT=$($LOCAL_COMMAND 2>&1)
    EXIT_CODE=$?
    if [ $EXIT_CODE -eq 0 ]; then
        echo "Validate ok"
    else
        echo "Validate KO!"
        echo "$OUTPUT"
        exit 1
    fi
else
    echo "No web/package.json, skipping web validation"
fi

# 2) Sync the version from the `version` file.
OUTPUT=$("$PYTHON" .others/version.py 2>&1)
EXIT_CODE=$?
if [ $EXIT_CODE -eq 0 ]; then
    echo "Version changed"
else
    echo "Can't change the version! check the .others/version.py"
    echo "$OUTPUT"
    exit 1
fi

# 3) Regenerate the multi-language READMEs.
OUTPUT=$("$PYTHON" .others/render_i18n.py --once 2>&1)
EXIT_CODE=$?
if [ $EXIT_CODE -eq 0 ]; then
    echo "i18n docs rendered"
else
    echo "Can't render i18n docs! check the .others/render_i18n.py"
    echo "$OUTPUT"
    exit 1
fi

# 4) Stage every file the hook may have touched.
git add version pyproject.toml __init__.py core/version.py
git add README.md docs/en/README.md docs/zh/README.md docs/zh-Hant/README.md
